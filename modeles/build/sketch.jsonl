{"command": "prop.setExpression", "params": {"layer": "Tete", "path": "transform/scale", "expression": "var tc = thisComp.layer(\"Controles\").effect(5)(1);\nvar base = 126, s = base;\nif (time < 0.42) {\n  var u = time / 0.42;\n  s = u < 0.6 ? base * 1.14 * (u / 0.6) : base * 1.14 - base * 0.14 * ((u - 0.6) / 0.4);\n}\nvar d = time - tc;\nif (d >= 0 && d < 0.15) s = base + 26 * (d / 0.15);\nelse if (d >= 0.15 && d < 0.4) s = base + 26 - 18 * ((d - 0.15) / 0.25);\nelse if (d >= 0.4) s = base + 8;\n[s, s, 100];"}}
{"command": "prop.setExpression", "params": {"layer": "Tete", "path": "transform/position", "expression": "var tc = thisComp.layer(\"Controles\").effect(5)(1), f = thisComp.layer(\"Controles\").effect(6)(1);\nvar bx = 540 + Math.sin(time * 1.4) * 5, by = 760 + Math.sin(time * 2.2) * 8;\nvar d = time - tc;\nif (d >= 0 && d < 0.75) {\n  var k = 1 - d / 0.75;\n  bx += Math.sin(time * 86) * f * k; by += Math.cos(time * 71) * f * 0.66 * k;\n}\n[bx, by, 0];"}}
{"command": "prop.setExpression", "params": {"layer": "Oeil G", "path": "transform/scale", "expression": "var tc = thisComp.layer(\"Controles\").effect(5)(1);\nvar x = 100, y = 100;\nvar p = 3.3, dd = (time + 0.7) % p;\nif (dd < 0.14) y = 100 - 92 * Math.sin(Math.PI * dd / 0.14);\nvar d = time - tc;\nif (d >= 0 && d < 0.9) { x = 120; y = Math.max(y, 130); }\n[x, y, 100];"}}
{"command": "prop.setExpression", "params": {"layer": "Oeil D", "path": "transform/scale", "expression": "var tc = thisComp.layer(\"Controles\").effect(5)(1);\nvar x = 100, y = 100;\nvar p = 3.3, dd = (time + 0.7) % p;\nif (dd < 0.14) y = 100 - 92 * Math.sin(Math.PI * dd / 0.14);\nvar d = time - tc;\nif (d >= 0 && d < 0.9) { x = 120; y = Math.max(y, 130); }\n[x, y, 100];"}}
{"command": "prop.setExpression", "params": {"layer": "Bouche", "path": "transform/scale", "expression": "var tc = thisComp.layer(\"Controles\").effect(5)(1);\nvar a = 0;\ntry { a = thisComp.layer(\"Audio Amplitude\").effect(3)(1); } catch (e) { a = 0; }\nvar x = 100, y = Math.min(170, 28 + a * 9);\nvar d = time - tc;\nif (d >= 0 && d < 0.8) { x = 128; y = 165; }\n[x, y, 100];"}}
