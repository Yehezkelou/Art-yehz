                          100.0
                        ]
                      },
                      "expr": {
                        "text": "var tc = thisComp.layer(\"Controles\").effect(5)(1);\nvar base = 126, s = base;\nif (time < 0.42) {\n  var u = time / 0.42;\n  s = u < 0.6 ? base * 1.14 * (u / 0.6) : base * 1.14 - base * 0.14 * ((u - 0.6) / 0.4);\n}\nvar d = time - tc;\nif (d >= 0 && d < 0.15) s = base + 26 * (d / 0.15);\nelse if (d >= 0.15 && d < 0.4) s = base + 26 - 18 * ((d - 0.15) / 0.25);\nelse if (d >= 0.4) s = base + 8;\n[s, s, 100];",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Percent"
                      },
