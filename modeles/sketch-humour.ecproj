                        "text": "var tc = thisComp.layer(\"Controles\").effect(5)(1);\nvar x = 100, y = 100;\nvar p = 3.3, dd = (time + 0.7) % p;\nif (dd < 0.14) y = 100 - 92 * Math.sin(Math.PI * dd / 0.14);\nvar d = time - tc;\nif (d >= 0 && d < 0.9) { x = 120; y = Math.max(y, 130); }\n[x, y, 100];",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Percent"
                      },
                      "spatial": false,
                      "hold_only": false,
                      "three_d_only": false,
