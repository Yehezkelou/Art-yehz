                      },
                      "expr": {
                        "text": "var tc = thisComp.layer(\"Controles\").effect(5)(1), f = thisComp.layer(\"Controles\").effect(6)(1);\nvar bx = 540 + Math.sin(time * 1.4) * 5, by = 760 + Math.sin(time * 2.2) * 8;\nvar d = time - tc;\nif (d >= 0 && d < 0.75) {\n  var k = 1 - d / 0.75;\n  bx += Math.sin(time * 86) * f * k; by += Math.cos(time * 71) * f * 0.66 * k;\n}\n[bx, by, 0];",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Point"
                      },
                      "spatial": true,
                      "hold_only": false,
                      "three_d_only": false,
