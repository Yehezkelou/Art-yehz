                      "expr": {
                        "text": "var s = 13.70, e = 14.45;\nvar bx = 540 + Math.sin(time * 1.4) * 5;\nvar by = 760 + Math.sin(time * 2.2) * 8;\nif (time >= s && time < e) {\n  var k = 1 - (time - s) / (e - s);\n  [bx + Math.sin(time * 86) * 30 * k, by + Math.cos(time * 71) * 20 * k, 0];\n} else {\n  [bx, by, 0];\n}",
