                      "expr": {
                        "text": "var t = time;\nvar x = 100, y = 100;\nvar blinks = [2.6, 6.4, 9.9, 11.8, 16.2];\nfor (var i = 0; i < blinks.length; i++) {\n  var d = t - blinks[i];\n  if (d >= 0 && d < 0.14) { y = 100 - 92 * Math.sin(Math.PI * d / 0.14); }\n}\nif (t >= 13.7 && t < 14.6) { x = 120; y = Math.max(y, 130); }\n[x, y, 100];",
                        "enabled": true
                      },
