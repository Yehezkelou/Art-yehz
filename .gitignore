# Logiciels : chacun a son propre dépôt git
logiciel/
# Rendus et exports lourds (refaits depuis les projets)
*.mp4
*.mov
*.wav
# Exception : voix de synthèse maison (VoiceStudio / OmniVoice, test J2), pas de voix d'autrui
!vulga-01-gps/voix/*.wav
plans/*.pdf
# Fichiers automatiques
EffectCraft Auto-Save/
*.sauvegarde-*.ecproj
__pycache__/
*.pyc
# Dossiers de travail
a-trier/*
!a-trier/README.md
regards/
*.log
# Références d'autres artistes : jamais publiées (droits d'auteur) ; copiées à la main d'une machine à l'autre
references/*
!references/README.md
# Skills tiers clonés (dépôts git à part) ; la version utilisée est copiée dans .claude/skills/
/skills/
# Séquences d'images composées par les scripts d'épisode (refaites par .montage/composer.py)
*/.montage/scene/
# Voix ElevenLabs (voix de la bibliothèque, pas les nôtres) : restent sur la machine
*.mp3
# Dépendances npm de l'outil de rendu 3D (refaites par npm ci)
outils/rendu3d/node_modules/
# Images rendues par outils/rendu3d pour les épisodes (refaites depuis les scènes .mjs)
*/.montage/3d/*/
